<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f4f7f6">

    <!-- SCREEN 1: THE LIVE CLASS BROWSER -->
    <LinearLayout
        android:id="@+id/browserLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Your Class"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2c3e50"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvScanning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scanning local network for teacher streams..."
            android:textColor="#7f8c8d"
            android:layout_marginBottom="24dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- We will programmatically inject Class buttons here -->
            <LinearLayout
                android:id="@+id/classListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- SCREEN 2: THE AI LIVENESS CAMERA (Hidden until a class is tapped) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please blink to mark attendance."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#99000000"
            android:padding="24dp"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>